# =================================================
# CQU JobWise - 环境变量配置模板
# =================================================
# 使用说明：
#   1. 复制本文件并重命名为 .env
#   2. 将下方的 "your_api_key_here" 替换为你的真实 API Key
#   3. 切勿将 .env 文件提交到 Git 仓库（已在 .gitignore 中排除）
# =================================================

# MiMo API 密钥（必填）
# 获取方式：前往 MiMo 开放平台申请
MIMO_API_KEY=your_api_key_here